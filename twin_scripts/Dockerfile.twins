#ENTRYPOINT /bin/bash

FROM full_a AS twins
RUN mkdir -p /twins && mv /app/spire /twins/spireA && rmdir /app

COPY --from=full_b /app/spire /twins/spireB

WORKDIR /twins/spireA/proxy/io_process

RUN rm -f io_process.o io_process && make SPIRE_DIR=../../ BINARY_NAME=io_process SPIRE_ROOT_DIR_REL_TO_PROXY=../

RUN rm -f io_process_B.o io_process_B && make SPIRE_DIR=../../../spireB/ BINARY_NAME=io_process_B SPIRE_ROOT_DIR_REL_TO_PROXY=../../spireB/

WORKDIR /twins/spireA
